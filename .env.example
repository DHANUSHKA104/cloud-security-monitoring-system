# Database configuration
DB_NAME=cloudsec
DB_USER=cloudsec
DB_PASSWORD=your_secure_db_password_here
DB_URL=jdbc:postgresql://127.0.0.1:5432/cloudsec

# JWT Authentication
JWT_SECRET=generate_a_64_character_hex_or_base64_secret_key_here
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Simulator & Dev Credentials
SIM_API_KEY=generate_a_secure_simulator_api_key_here
SIM_ADMIN_EMAIL=admin@cloudsec.local
SIM_ADMIN_PASSWORD=your_admin_seed_password_here
DEV_SEED_PASSWORD=your_dev_seed_password_here

# Python Analytics Service
ANALYTICS_URL=http://127.0.0.1:8000
ANALYTICS_API_KEY=generate_a_secure_analytics_api_key_here
ANALYTICS_DB_URL=postgresql://analytics_ro:your_analytics_ro_password_here@127.0.0.1:5432/cloudsec
ANALYTICS_DB_USER=analytics_ro
ANALYTICS_DB_PASSWORD=your_analytics_ro_password_here

# Spring Profile
SPRING_PROFILES_ACTIVE=dev
ADMIN_INITIAL_PASSWORD=
