# Database configuration
DB_NAME=cloudsec
DB_USER=cloudsec
DB_PASSWORD=change-me
DB_URL=jdbc:postgresql://localhost:5432/cloudsec

# JWT Authentication
JWT_SECRET=change-me-to-a-long-random-string-at-least-256-bits-secure-key
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Simulator & Dev Admin
SIM_API_KEY=change-me-sim-api-key
SIM_ADMIN_EMAIL=admin@cloudsec.local
SIM_ADMIN_PASSWORD=change-me
DEV_SEED_PASSWORD=change-me

# Python Analytics Service
ANALYTICS_URL=http://localhost:8000
ANALYTICS_API_KEY=change-me-analytics-key
ANALYTICS_DB_URL=postgresql://analytics_ro:change-me@localhost:5432/cloudsec
ANALYTICS_DB_USER=analytics_ro
ANALYTICS_DB_PASSWORD=change-me

# Spring Configuration
SPRING_PROFILES_ACTIVE=dev
ADMIN_INITIAL_PASSWORD=
